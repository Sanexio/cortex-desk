{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cortex Desk",
  "version": "0.1.0",
  "identifier": "de.sanexio.cortex-desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cortex Desk",
        "width": 1024,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY",
      "endpoints": [
        "https://updates.example.com/cortex-desk/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
