{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cortex Desk",
  "version": "0.1.0",
  "identifier": "de.sanexio.cortex-desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cortex Desk",
        "width": 1024,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBMDExMDlCNTBERDg0QjYKUldTMmhOMVFteEFCcXBhUkZnVzMxSmtuSFpQbTJQSXlmRE1jbW9BS05QK0l6RTIrTW9EUDFrdmQK",
      "endpoints": []
    }
  }
}
